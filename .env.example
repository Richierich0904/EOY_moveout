# Copy to .env.local and edit. Everything here has a safe default for trying the site on your own computer.
# .env.local stays on your computer and is never uploaded to GitHub. Keep passwords and keys there,
# not in the terminal.

# The defaults below are already set for Mercersburg Academy. Lines starting with # are examples.
APP_NAME=Le-SWAP
SCHOOL_NAME=Mercersburg Academy
# The school's time zone. Weeks, months and draw deadlines follow it.
SCHOOL_TZ=America/New_York

# ---- Who can join ----
# Only these email domains can sign up.
ALLOWED_EMAIL_DOMAINS=mercersburg.edu
# The part before the @ must look like a student address: last name, first initial, class year
# (smithj27). The class year is read from it. Leave unset for that default.
# STUDENT_EMAIL_PATTERN=^[a-z][a-z'.-]*[a-z](\d{2}|\d{4})$
# The last name typed at sign-up must match the one in the email. Set to off to stop checking.
# NAME_CHECK=off

# ---- Mail (required before real students use the site) ----
# The mail server that sends sign-up and password-reset codes. Check it with:  npm run mail:test you@example.com
# On a production build (npm start), sign-up stays closed until this is set, and codes are never shown on screen.
#
# For testing with a personal Gmail account (not for launch: Google limits it to about 500 emails a day):
#   1. Turn on 2-Step Verification for the Google account.
#   2. Create an "app password" in the account's security settings. It is 16 letters.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=your-address@gmail.com
# SMTP_PASS=your16letterapppassword
#
# For launch, use an email service with a domain you own, for example Resend:
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_USER=resend
# SMTP_PASS=your-resend-api-key
# MAIL_FROM=Le-SWAP <no-reply@your-domain.org>
#
# MAIL_FROM is optional when SMTP_USER is itself an email address (as with Gmail).
# One-line alternative to the four settings above:
# SMTP_URL=smtps://user:password@smtp.example.com:465

# ---- Who looks after it ----
# Organisers: they see reports, can read conversations, remove posts, pause accounts and run draws.
# Organisers may have any address on the school domain, so adults can be listed here.
# ADMIN_EMAILS=smithj27@mercersburg.edu,teacher@mercersburg.edu
# The adult students can go to. Shown on the Help page and to paused accounts.
# SAFETY_CONTACT_NAME=Dean of Students
# SAFETY_CONTACT_EMAIL=dean@mercersburg.edu

# ---- School details ----
# Comma-separated. Shown as dropdowns. Meeting spots should be public places, never dorm rooms.
HOUSES=Main,Tippetts,Keil,Culberson,Fowle,South,Swank
HANDOFF_SPOTS=Dining hall entrance,Library steps,Student center,Dorm common room
# Posts mentioning any of these words are held for an organiser to check. Leave unset for the built-in list.
# BANNED_WORDS=vape,alcohol,knife

# ---- AI safety judge (optional) ----
# With a key set, every listing, wanted post and photo is checked by a Claude model before it goes
# live. Anything it is unsure about is held for an organiser. It never sees names, emails or messages.
# Without a key, posts are checked by the banned-word list only.
# Get the school's approval before turning this on, because post text and photos leave the server.
# Check it with:  npm run judge:test
# ANTHROPIC_API_KEY=sk-ant-...
# The model that does the checking. Claude Haiku 5.5 is fast and cheap.
# MODERATION_MODEL=claude-haiku-5-5
# Force the judge off even when a key is set.
# AI_JUDGE=off

# Where the SQLite file and uploaded photos live. Defaults to ./data
# DATA_DIR=/var/lib/swap

# Confirmed giveaways needed for one entry in the giveaway draw.
GIVEAWAYS_PER_TICKET=3

# ---- Demo only ----
# Lets a production build run without a mail service, with codes shown on screen and any email allowed.
# NEVER set this on the real site. A banner is shown on every page while it is on.
# DEMO_MODE=1
